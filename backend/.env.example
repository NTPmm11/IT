# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงเครื่องตัวเอง: cp .env.example .env
PORT=4000
# interface ที่ API รับ request — ไม่ตั้ง = 0.0.0.0 (รับจากเครื่องอื่นในวงแลนด้วย)
# รับเฉพาะเครื่องตัวเองตั้งเป็น localhost
# HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=CR

# ลิงก์กลับหน้าอนุมัติที่แนบไปในอีเมล + origin เดียวที่ CORS ยอมรับ
# (ต้องตรงกับ port ที่ frontend รันอยู่ — Vite default คือ 5173)
FRONTEND_URL=http://localhost:5173

# กุญแจที่ใช้เซ็น JWT — ห้ามให้ใครรู้ ใครรู้ = ปลอม token เป็น it_admin ได้
# สร้างใหม่: openssl rand -base64 48
# ไม่ตั้ง (หรือสั้นกว่า 32 ตัวอักษร) = server สุ่มให้ใหม่ทุกครั้งที่ restart -> ต้อง login ใหม่ทุกรอบ
JWT_SECRET=
# JWT_ISSUER=cr-system
# JWT_AUDIENCE=cr-system
# token มีอายุกี่ชั่วโมง (ไม่ตั้ง = 8)
# JWT_EXPIRES_HOURS=8

# ยิง POST /api/auth/login ได้กี่ครั้งต่อนาทีต่อ IP (ไม่ตั้ง = 10) เกินแล้วได้ 429
# LOGIN_RATE_LIMIT=10

# true = ยอมให้ approver/it_admin อนุมัติคำขอที่ตัวเองยื่นได้
# ไม่ตั้ง = ห้าม (คนขอกับคนตรวจต้องคนละคน)
# ALLOW_SELF_APPROVAL=false

# ไม่ตั้ง SMTP_HOST = ไม่ส่งอีเมลออกไปไหน เขียนเป็นไฟล์ .eml ลงโฟลเดอร์
# bin/Debug/net8.0/MailDrop/ แทน (เปิดดูด้วย mail client ทั่วไปได้)
# ใช้งานจริงค่อยเติมค่าพวกนี้:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ผู้ส่งที่โผล่ในอีเมล — ไม่ตั้งจะใช้ SMTP_USER แทน
# MAIL_FROM=
# MAIL_FROM_NAME=CR System
