# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงเครื่องตัวเอง: cp .env.example .env
PORT=4000

FIREBASE_PROJECT_ID=cr-project-b10b1
# Local development: absolute path to a NEW service-account JSON file outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/new-service-account.json
# Render: set these two variables from the service-account JSON instead of uploading the JSON file.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@cr-project-b10b1.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Cloud Functions uses its runtime identity; do not set a local credentials path there.
# Optional local emulator (no production credentials needed):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Only used by npm run import:mysql; API routes use Firestore.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=CR

# ลิงก์กลับหน้าอนุมัติที่แนบไปในอีเมล (ต้องตรงกับ port ที่ frontend รันอยู่ — Vite default คือ 5173)
FRONTEND_URL=http://localhost:5173

# ไม่ตั้งค่า SMTP_HOST ไว้ = ระบบใช้ Ethereal (กล่องจดหมายปลอมสำหรับ dev) แทนอัตโนมัติ
# ใช้งานจริงค่อยเติมค่าพวกนี้:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
